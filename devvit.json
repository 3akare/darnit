{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "darnit",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "splash.html",
        "height": "regular"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true
  },
  "menu": {
    "items": [
      {
        "label": "DarnIt!: post today's pattern",
        "description": "Manual fallback if the daily post is missing",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/daily-post"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "0 1 * * *"
      }
    }
  },
  "dev": {
    "subreddit": "DarnItGame"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
