{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/types/preview",
    "tsBuildInfoFile": "../dist/types/preview/tsconfig.tsbuildinfo",
    "rootDir": "..",
    "paths": {
      "@devvit/web/server": [
        "../src/preview/devvit-server.ts"
      ],
      "@devvit/web/client": [
        "../src/preview/devvit-client.ts"
      ]
    }
  },
  "include": [
    "../src/preview/**/*",
    "../src/client/**/*",
    "../src/shared/**/*",
    "../src/server/core/**/*",
    "../src/server/bank/**/*",
    "../src/server/routes/api.ts",
    "../src/server/**/*.json",
    "../tools/brand/brand.ts"
  ],
  "exclude": [
    "../src/**/*.test.ts",
    "../src/server/core/daily.ts"
  ]
}
